{% comment %}
  Sourboo About Page Visual Storytelling Section
  Complete 6-chapter founder narrative for Sakshi & Sourboo
{% endcomment %}

<article class="sb-about-section" aria-label="Our Story">
  <!-- CHAPTER 1: Founder Welcome -->
  <div class="sb-about-hero-grid">
    <div class="sb-about-cover-wrap">
      <img
        src="{{ 'about-cover.JPG' | asset_url }}"
        alt="Sakshi, Founder of Sourboo"
        loading="lazy"
        width="680"
        height="840"
      />
    </div>

    <div>
      <h1 class="font-coolvetica text-pink" style="font-size: clamp(2.6rem, 5.5vw, 5rem); line-height: 0.94; margin: 0 0 16px;">
        hi i am sakshi,
      </h1>
      <p class="font-schoolbell text-pickle" style="font-size: clamp(1.8rem, 3.2vw, 3rem); line-height: 1.1; margin: 0 0 24px;">
        and i am really glad you are here
      </p>
      <p class="font-schoolbell" style="font-size: clamp(1.35rem, 2vw, 1.8rem); line-height: 1.25; color: var(--sb-text-dark);">
        if u are here, i am assuming, you like sour or curious enough to try it.
      </p>
    </div>
  </div>

  <!-- CHAPTER 2: Obsession With Flavours -->
  <div style="margin: 80px 0; text-align: center;">
    <h2 class="font-coolvetica text-pink" style="font-size: clamp(2rem, 4vw, 3.8rem); max-width: 900px; margin: 0 auto 36px; line-height: 1.05;">
      I've always been (annoyingly) obsessed with flavours.
    </h2>

    <div style="display: flex; flex-wrap: wrap; justify-content: center; gap: 24px;">
      <img src="{{ 'section-two-1.svg' | asset_url }}" alt="Mixing drinks" style="width: min(88vw, 320px); border-radius: 20px;" loading="lazy" />
      <img src="{{ 'section-two-2.svg' | asset_url }}" alt="Tasting everything" style="width: min(88vw, 320px); border-radius: 20px;" loading="lazy" />
      <img src="{{ 'section-two-3.svg' | asset_url }}" alt="Food journey" style="width: min(88vw, 320px); border-radius: 20px;" loading="lazy" />
    </div>

    <p class="font-schoolbell" style="font-size: clamp(1.4rem, 2.4vw, 2.2rem); max-width: 780px; margin: 32px auto 0; color: var(--sb-text-charcoal); line-height: 1.2;">
      spent 5 years around food and drinks from london bar shifts to a 9-5 desk job in India.
    </p>
  </div>

  <!-- CHAPTER 3: Tongue Mapping & India Callouts -->
  <div style="margin: 90px 0; text-align: center;">
    <h2 class="font-coolvetica text-pickle" style="font-size: clamp(2.4rem, 4.8vw, 4.4rem); margin: 0 0 20px;">
      different lives, same cravings
    </h2>

    <div class="sb-tongue-map-wrap">
      <img
        src="{{ 'section-three-tongue.svg' | asset_url }}"
        alt="Illustrated Tongue"
        loading="lazy"
        style="width: 100%; height: auto;"
      />
      <!-- Dynamic Blue Dotted Lines Callouts -->
      <div class="sb-tongue-callout" style="top: 14%; left: 10%;">
        → India loves chaaat
      </div>
      <div class="sb-tongue-callout" style="top: 42%; right: 4%;">
        → India loves flavour
      </div>
      <div class="sb-tongue-callout" style="bottom: 16%; left: 12%;">
        → India loves that sour & spicy hit
      </div>
    </div>

    <p class="font-schoolbell" style="font-size: clamp(1.6rem, 2.6vw, 2.4rem); color: var(--sb-text-dark); margin-top: 24px;">
      Nothing worked for a desi palate that loves...
    </p>
  </div>

  <!-- CHAPTER 4: Flavour Blobs & GIFs -->
  <div style="margin: 80px 0; text-align: center;">
    <div style="display: flex; justify-content: center; gap: 24px; margin-bottom: 30px;">
      <span class="sb-brush-cta" style="background-image: url('{{ 'boldbg.svg' | asset_url }}'); color: #fff;">BOLD</span>
      <span class="sb-brush-cta" style="background-image: url('{{ 'spicybg.svg' | asset_url }}'); color: #fff;">spicy</span>
      <span class="sb-brush-cta" style="background-image: url('{{ 'sourbg.svg' | asset_url }}'); color: #fff;">sour</span>
    </div>

    <p class="font-schoolbell" style="font-size: clamp(1.5rem, 2.5vw, 2.4rem); max-width: 720px; margin: 0 auto 40px; color: var(--sb-text-muted);">
      but doesn't want to feel weighed down after snacking.
    </p>

    <h3 class="font-coolvetica text-pink" style="font-size: clamp(2rem, 3.8vw, 3.6rem); margin: 0 0 20px;">
      MY BIGGEST ISSUE?
    </h3>
    <p class="font-schoolbell" style="font-size: clamp(1.6rem, 2.8vw, 2.6rem); color: #171717; margin: 0 0 32px;">
      Sour was always treated like a side.
    </p>

    <div style="display: flex; justify-content: center; align-items: center; gap: 40px; flex-wrap: wrap;">
      <div>
        <img src="{{ 'lemonsqueze.gif' | asset_url }}" alt="Lemon squeeze" style="width: 140px; border-radius: 50%;" loading="lazy" />
        <p class="font-schoolbell" style="font-size: 1.25rem; margin-top: 8px;">A squeeze here.</p>
      </div>
      <div>
        <img src="{{ 'spoonofpickle.gif' | asset_url }}" alt="Spoon of pickle" style="width: 140px; border-radius: 50%;" loading="lazy" />
        <p class="font-schoolbell" style="font-size: 1.25rem; margin-top: 8px;">A spoon of pickle there.</p>
      </div>
    </div>
  </div>

  <!-- CHAPTER 5: Paper Tear & Introducing Sourboo -->
  <div style="position: relative; margin: 90px 0; text-align: center;">
    <img src="{{ 'paper-tear.svg' | asset_url }}" alt="Paper tear" style="width: 100%; height: auto; margin-bottom: 30px;" loading="lazy" />

    <p class="font-schoolbell text-pickle" style="font-size: clamp(1.8rem, 3vw, 2.8rem); margin: 0 0 12px;">
      Introducing
    </p>
    <img src="{{ 'logo.svg' | asset_url }}" alt="Sourboo logo" style="width: 240px; margin: 0 auto 16px;" loading="lazy" />
    <img src="{{ 'tagline.svg' | asset_url }}" alt="Sour first snack" style="width: 320px; margin: 0 auto 28px;" loading="lazy" />

    <p class="font-schoolbell" style="font-size: clamp(1.6rem, 2.6vw, 2.6rem); max-width: 820px; margin: 0 auto 16px; line-height: 1.2;">
      sour first snack, made for people who don't eat quietly.<br>
      for women who love loud flavours, strong opinions, and fully indulging.
    </p>
    <p class="font-schoolbell text-pink" style="font-size: clamp(1.4rem, 2.2vw, 2.1rem); margin: 0;">
      The kind who make faces when they eat. The kind who ask for extra nimbu.
    </p>
  </div>

  <!-- CHAPTER 6: Founder Envelope Invitation -->
  <div style="margin-top: 80px; text-align: center;">
    <!-- Event Photos Strip -->
    <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(240px, 1fr)); gap: 18px; max-width: 1100px; margin: 0 auto 40px;">
      <img src="{{ 'section-six-top-1.webp' | asset_url }}" alt="Tasting moment" style="border-radius: 20px; width: 100%; aspect-ratio: 4/3; object-fit: cover;" loading="lazy" />
      <img src="{{ 'section-six-top-2.webp' | asset_url }}" alt="Sourboo team" style="border-radius: 20px; width: 100%; aspect-ratio: 4/3; object-fit: cover;" loading="lazy" />
      <img src="{{ 'section-six-top-3.webp' | asset_url }}" alt="Customer tasting" style="border-radius: 20px; width: 100%; aspect-ratio: 4/3; object-fit: cover;" loading="lazy" />
    </div>

    <!-- Letter Envelope Graphic -->
    <div style="position: relative; max-width: 580px; margin: 0 auto; background: var(--sb-bg-yellow); border: 3px solid var(--sb-pickle-green); border-radius: 28px; padding: 36px 30px; box-shadow: 0 16px 32px rgba(0,0,0,0.12);">
      <h3 class="font-schoolbell text-pink" style="font-size: 2.2rem; margin: 0 0 14px;">
        hellooo
      </h3>
      <p class="font-schoolbell" style="font-size: 1.45rem; line-height: 1.3; color: #171717; margin: 0 0 18px;">
        i am sakshi the founder of sourboo.<br><br>
        we are hosting our next tasting pop-up soon! come through and make some sour faces with us.
      </p>
      <p class="font-schoolbell text-pink" style="font-size: 1.6rem; margin: 0;">
        xx
      </p>
    </div>
  </div>
</article>

{% schema %}
{
  "name": "About Story",
  "settings": []
}
{% endschema %}
