{% comment %}
  Sourboo Hero Section
  Feature: Real hands holding pickle slices, expressive alternating typography
{% endcomment %}

<section class="sb-hero" aria-label="Hero Section">
  <div class="sb-hero-media-wrap">
    <img
      src="{{ section.settings.hero_image | default: 'hero-placeholder.webp' | asset_url }}"
      alt="{{ section.settings.hero_image_alt | default: 'Hands holding crunchy Sourboo pickle slices' }}"
      class="sb-hero-img"
      width="1600"
      height="900"
      fetchpriority="high"
    />
    <div class="sb-hero-overlay"></div>

    <div class="sb-hero-headline-container">
      <h1 class="sb-hero-h1">
        <span class="sb-hero-line1">
          {% render 'cool-rascal-text', text: section.settings.headline_line1 | default: 'the sourboo way,' %}
        </span>
        <span class="sb-hero-line2">
          {% render 'cool-rascal-text', text: section.settings.headline_line2 | default: 'cravings comes first' %}
        </span>
      </h1>
    </div>

    <a href="#ProductShowcase" class="sb-hero-scroll-pill" aria-label="Scroll to products">
      <span>discover flavours</span>
      <span>↓</span>
    </a>
  </div>
</section>

{% schema %}
{
  "name": "Hero",
  "settings": [
    {
      "type": "text",
      "id": "headline_line1",
      "label": "Headline Line 1",
      "default": "the sourboo way,"
    },
    {
      "type": "text",
      "id": "headline_line2",
      "label": "Headline Line 2",
      "default": "cravings comes first"
    },
    {
      "type": "image_picker",
      "id": "hero_image",
      "label": "Hero Image (Must be authentic pickles photography)"
    },
    {
      "type": "text",
      "id": "hero_image_alt",
      "label": "Hero Image Alt Text",
      "default": "Hands holding fresh crunchy Sourboo pickle slices"
    }
  ],
  "presets": [
    {
      "name": "Hero"
    }
  ]
}
{% endschema %}
