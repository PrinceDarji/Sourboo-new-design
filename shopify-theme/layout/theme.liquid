<!doctype html>
<html class="no-js" lang="{{ request.locale.iso_code | default: 'en' }}">
  <head>
    <meta charset="utf-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover">
    <meta name="theme-color" content="#E9ECD9">
    <link rel="canonical" href="{{ canonical_url | default: shop.url }}">

    <link rel="icon" type="image/x-icon" href="{{ 'favicon.ico' | asset_url }}">
    <link rel="apple-touch-icon" href="{{ 'apple-touch-icon.png' | asset_url }}">

    <title>
      {{ page_title | default: 'Sourboo | Spicy Sour Gherkin Snacks & Pickled Snacks' }}
      {%- if current_tags %} &ndash; tagged "{{ current_tags | join: ', ' }}"{% endif -%}
      {%- if current_page != 1 %} &ndash; Page {{ current_page }}{% endif -%}
      {%- unless page_title contains shop.name %} &ndash; {{ shop.name | default: 'Sourboo' }}{% endunless -%}
    </title>

    {% if page_description %}
      <meta name="description" content="{{ page_description | escape }}">
    {% else %}
      <meta name="description" content="Sourboo makes spicy-sour gherkin snacks and snackable pickles for people obsessed with tangy munchies, cocktails and bold snacking.">
    {% endif %}

    <!-- Fonts Preload -->
    <link rel="preload" href="{{ 'coolvetica.ttf' | asset_url }}" as="font" type="font/ttf" crossorigin>
    <link rel="preload" href="{{ 'rascal.ttf' | asset_url }}" as="font" type="font/ttf" crossorigin>
    <link rel="preload" href="{{ 'Schoolbell-Regular.ttf' | asset_url }}" as="font" type="font/ttf" crossorigin>

    <!-- Theme Stylesheet -->
    <link rel="stylesheet" href="{{ 'sourboo.css' | asset_url }}">

    {{ content_for_header }}
  </head>

  <body class="template-{{ template.name | default: 'index' }}">
    <!-- Header Section with Organic Navigation -->
    {% section 'header' %}

    <!-- Main Content Area -->
    <main id="MainContent" role="main" tabindex="-1">
      {{ content_for_layout }}
    </main>

    <!-- Cart Drawer Component -->
    {% section 'cart-drawer' %}

    <!-- Personality Popup & 5% Coupon Modal -->
    {% section 'personality-popup' %}

    <!-- Site Footer Section -->
    {% section 'footer' %}

    <!-- Theme JavaScript Core -->
    <script src="{{ 'sourboo.js' | asset_url }}" defer></script>
    <script src="{{ 'flavor-matcher.js' | asset_url }}" defer></script>
  </body>
</html>
